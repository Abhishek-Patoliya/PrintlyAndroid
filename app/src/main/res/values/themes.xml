<resources xmlns:tools="http://schemas.android.com/tools">
    <!-- Actual theming (colors, typography) lives in Compose (ui/theme/Theme.kt) —
         this is only the minimal system theme required for the launch/splash
         window before Compose content attaches. -->
    <style name="Theme.Printly" parent="android:Theme.Material.Light.NoActionBar">
        <item name="android:windowBackground">@android:color/white</item>
        <item name="android:statusBarColor" tools:targetApi="21">@android:color/white</item>
    </style>
</resources>
